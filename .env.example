# Copy to `.env` and fill in from Firebase console → Project settings → Your apps → Web app.
# These identify the project and are safe to ship in the page; access is controlled by
# firestore.rules. While they are empty the booking form only simulates sending and
# /admin shows a "not configured" notice.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
