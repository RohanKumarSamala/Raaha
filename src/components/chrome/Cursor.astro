---
/**
 * Custom cursor (fine pointers only). States are driven by [data-cursor] on
 * hovered elements: link | view | drag | hide | text. See scripts/modules/cursor.ts.
 */
---

<div class="cursor" aria-hidden="true" data-cursor-root>
  <div class="cursor__ring" data-cursor-ring>
    <span class="cursor__label" data-cursor-label></span>
  </div>
  <div class="cursor__dot" data-cursor-dot></div>
</div>

<style>
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: var(--z-cursor);
    pointer-events: none;
    display: none;
  }
  :global(.has-cursor) .cursor {
    display: block;
  }
  :global(.has-cursor),
  :global(.has-cursor) :is(a, button, [data-cursor], label, summary) {
    cursor: none;
  }
  :global(.has-cursor) :is(input, textarea, select) {
    cursor: text;
  }

  .cursor__ring,
  .cursor__dot {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 50%;
    will-change: transform;
  }
  .cursor__dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: #fff;
    mix-blend-mode: difference;
    transition: width 0.4s var(--ease-out), height 0.4s var(--ease-out), margin 0.4s var(--ease-out), opacity 0.3s;
  }
  .cursor__ring {
    width: 38px;
    height: 38px;
    margin: -19px 0 0 -19px;
    border: 1px solid rgb(255 255 255 / 0.9);
    mix-blend-mode: difference;
    display: grid;
    place-items: center;
    transition:
      width 0.6s var(--ease-out),
      height 0.6s var(--ease-out),
      margin 0.6s var(--ease-out),
      background-color 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out),
      opacity 0.4s;
  }
  .cursor__label {
    font-family: var(--font-body);
    font-stretch: 125%;
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--c-ink);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.3s, transform 0.5s var(--ease-out);
    white-space: nowrap;
    padding-left: 0.28em;
  }

  :global(.cursor--link) .cursor__ring {
    width: 58px;
    height: 58px;
    margin: -29px 0 0 -29px;
    border-color: rgb(255 255 255 / 0.5);
  }
  :global(.cursor--link) .cursor__dot {
    opacity: 0;
  }

  :global(:is(.cursor--view, .cursor--drag)) .cursor__ring {
    width: 96px;
    height: 96px;
    margin: -48px 0 0 -48px;
    background: var(--c-ivory);
    border-color: transparent;
    mix-blend-mode: normal;
  }
  :global(:is(.cursor--view, .cursor--drag)) .cursor__label {
    opacity: 1;
    transform: none;
  }
  :global(:is(.cursor--view, .cursor--drag)) .cursor__dot {
    opacity: 0;
  }

  :global(:is(.cursor--hide, .cursor--text)) .cursor__ring {
    width: 0;
    height: 0;
    margin: 0;
    opacity: 0;
  }
  :global(.cursor--text) .cursor__dot {
    opacity: 0;
  }
  :global(.cursor--out) :is(.cursor__ring, .cursor__dot) {
    opacity: 0 !important;
  }
  :global(.cursor--down) .cursor__ring {
    scale: 0.85;
  }
</style>
