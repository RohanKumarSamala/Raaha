---
/**
 * Large circular CTA with a slowly orbiting arc. Magnetic on desktop.
 * Pass `href` for navigation or `action="booking"` to open the booking modal.
 */
import RollText from './RollText.astro';

interface Props {
  label: string;
  href?: string;
  action?: 'booking' | 'top';
  size?: 'lg' | 'sm';
  class?: string;
  context?: string;
}
const { label, href, action, size = 'lg', class: cls, context } = Astro.props;

// Break the label into two balanced lines, as in the reference.
const words = label.split(' ');
const half = Math.ceil(words.length / 2);
const lines = words.length > 1 && size === 'lg' ? [words.slice(0, half).join(' '), words.slice(half).join(' ')] : [label];
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn-circle', `btn-circle--${size}`, cls]}
  href={href}
  type={href ? undefined : 'button'}
  data-action={action}
  data-context={context}
  data-magnetic
  data-cursor="hide"
  data-roll
  aria-label={label}
>
  <span class="btn-circle__ring" aria-hidden="true">
    <svg viewBox="0 0 100 100">
      <circle class="btn-circle__track" cx="50" cy="50" r="49.5" />
      <circle class="btn-circle__arc" cx="50" cy="50" r="49.5" pathLength="100" />
    </svg>
  </span>
  <span class="btn-circle__label l2" aria-hidden="true" data-magnetic-inner>
    {lines.map((l) => <span class="btn-circle__line"><RollText text={l} /></span>)}
  </span>
</Tag>

<style is:global>
  .btn-circle {
    --size: calc(187 * var(--u));
    position: relative;
    display: inline-grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    text-align: left;
  }
  .btn-circle--sm {
    --size: max(calc(40 * var(--u)), 44px);
  }
  @media (max-width: 767px) {
    .btn-circle {
      --size: calc(150 * var(--u));
    }
    .btn-circle--sm {
      --size: 44px;
    }
  }
  .btn-circle__ring {
    position: absolute;
    inset: 0;
    transition: transform 0.9s var(--ease-out);
  }
  .btn-circle__ring svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: circle-orbit 18s linear infinite;
  }
  .btn-circle__track,
  .btn-circle__arc {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .btn-circle__track {
    opacity: 0.28;
  }
  .btn-circle__arc {
    stroke-width: 1.5;
    stroke-dasharray: 7 43;
    transition: stroke-dasharray 1s var(--ease-in-out);
  }
  .btn-circle__label {
    position: relative;
    display: flex;
    flex-direction: column;
    line-height: 1.5;
  }
  .btn-circle__line {
    display: block;
  }
  .btn-circle--sm .btn-circle__label {
    letter-spacing: 0.12em;
  }
  @media (hover: hover) {
    .btn-circle:hover .btn-circle__arc {
      stroke-dasharray: 50 0;
    }
    .btn-circle:hover .btn-circle__ring {
      transform: scale(1.06);
    }
  }
  @keyframes circle-orbit {
    to {
      transform: rotate(360deg);
    }
  }
</style>
