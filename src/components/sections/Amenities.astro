---
import { amenities } from '@/data/amenities';
import Media from '../ui/Media.astro';
import CircleButton from '../ui/CircleButton.astro';

interface Props {
  id?: string;
}
const { id = 'amenities' } = Astro.props;
---

<section class="amen t-image" id={id} data-header="light" data-amen style={`--count:${amenities.length}`} aria-labelledby={`${id}-title`}>
  <h2 class="sr-only" id={`${id}-title`}>Amenities</h2>
  <div class="amen__sticky">
    <div class="amen__bgs">
      {
        amenities.map((a, i) => (
          <div class:list={['amen__bg', i === 0 && 'is-active']} data-amen-bg>
            <Media media={a.image} fill sizes="100vw" />
          </div>
        ))
      }
    </div>

    <div class="amen__nav">
      <span class="amen__rail" aria-hidden="true"><i data-amen-rail></i></span>
      <ol class="amen__list">
        {
          amenities.map((a, i) => (
            <li>
              <button type="button" class:list={['amen__item h5', i === 0 && 'is-active']} data-amen-item aria-current={i === 0 ? 'true' : undefined} data-cursor="link">
                {a.name}
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="amen__copy">
      {
        amenities.map((a, i) => (
          <div class:list={['amen__text', i === 0 && 'is-active']} data-amen-text aria-hidden={i !== 0 ? 'true' : undefined}>
            <p class="amen__label l2">{a.name}</p>
            <p class="amen__quote h5">{a.text}</p>
          </div>
        ))
      }
    </div>

    <div class="amen__cta">
      <CircleButton label="Book a call now" action="booking" />
    </div>
  </div>

  <!-- Mobile: swipeable cards -->
  <ul class="amen__cards" data-lenis-prevent-touch>
    {
      amenities.map((a) => (
        <li class="amen__card">
          <Media media={a.image} ratio="4 / 5" sizes="80vw" />
          <p class="l2">{a.name}</p>
          <p class="p1">{a.text}</p>
        </li>
      ))
    }
  </ul>
</section>
<div class="amen-spacer" data-amen-spacer aria-hidden="true" style={`--count:${amenities.length}`}></div>

<style is:global>
  .amen {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: calc(820 * var(--u));
    z-index: 1;
    overflow: hidden;
    background: var(--c-ink);
  }
  /* a short hold on the photo before the next section rises over it */
  .amen-spacer {
    height: 30svh;
  }
  .amen__sticky {
    position: absolute;
    inset: 0;
  }
  .amen__bgs,
  .amen__bg {
    position: absolute;
    inset: 0;
  }
  .amen__bg {
    visibility: hidden;
  }
  .amen__bg.is-active {
    visibility: visible;
  }
  .amen__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    /* shade where the words sit — the list top-right, the statement bottom-left — so
       they read over any photo, bright sky and floodlights included */
    background:
      radial-gradient(120% 90% at 100% 18%, rgb(22 9 5 / 0.62), transparent 58%),
      linear-gradient(to top, rgb(22 9 5 / 0.72), rgb(22 9 5 / 0.3) 34%, transparent 58%),
      linear-gradient(90deg, rgb(22 9 5 / 0.25), transparent 45%);
    pointer-events: none;
  }

  .amen__nav {
    position: absolute;
    left: calc(1086 * var(--u));
    top: calc(160 * var(--u));
    display: flex;
    gap: calc(16 * var(--u));
  }
  .amen__rail {
    position: relative;
    width: 1px;
    background: rgb(255 255 255 / 0.45);
  }
  .amen__rail i {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: calc(100% / var(--count));
    background: currentColor;
    transition: transform 0.9s var(--ease-in-out);
  }
  .amen__list {
    display: grid;
  }
  .amen__item {
    display: block;
    padding: calc(1 * var(--u)) 0;
    text-align: left;
    opacity: 0.62;
    text-shadow: 0 1px calc(22 * var(--u)) rgb(22 9 5 / 0.55);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .amen__item.is-active {
    opacity: 1;
  }
  @media (hover: hover) {
    .amen__item:hover {
      opacity: 0.85;
      transform: translateX(6px);
    }
  }

  .amen__copy {
    position: absolute;
    left: calc(196 * var(--u));
    bottom: calc(96 * var(--u));
    width: calc(700 * var(--u));
    display: grid;
    align-items: end;
  }
  .amen__text {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .amen__text.is-active {
    visibility: visible;
  }
  .amen__label {
    margin-left: calc(154 * var(--u));
    margin-bottom: calc(32 * var(--u));
  }
  .amen__label,
  .amen__quote {
    text-shadow: 0 1px calc(22 * var(--u)) rgb(22 9 5 / 0.55);
  }
  .amen__quote {
    text-indent: calc(154 * var(--u));
    line-height: 1.02;
  }
  /* while the lines are split for the reveal, only the first keeps the indent */
  .amen__quote * {
    text-indent: 0;
  }
  .amen__quote > .split-line-mask:first-child > .split-line {
    text-indent: calc(154 * var(--u));
  }
  .amen__cta {
    position: absolute;
    left: calc(1100 * var(--u));
    top: calc(690 * var(--u));
  }
  .amen__cards {
    display: none;
  }

  @media (max-width: 767px) {
    .amen {
      position: relative;
      height: auto;
      min-height: 0;
      background: var(--c-ink);
      padding: 88px 0 72px;
    }
    .amen-spacer,
    .amen__sticky {
      display: none;
    }
    .amen__cards {
      display: flex;
      gap: 14px;
      padding: 0 var(--offset);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .amen__cards::-webkit-scrollbar {
      display: none;
    }
    .amen__card {
      flex: 0 0 78%;
      scroll-snap-align: start;
      display: grid;
      gap: 12px;
      align-content: start;
    }
    .amen__card .l2 {
      margin-top: 8px;
    }
    .amen__card .p1 {
      opacity: 0.8;
    }
  }
</style>
