---
import { home } from '@/data/home';
import Media from '../ui/Media.astro';

const residenceTypes = home.types;
const n = residenceTypes.length;
---

<section class="types t-mist" id="residences" data-header="ink" data-types aria-roledescription="carousel" aria-label="Residence types">
  <div class="types__inner">
    <div class="types__stats" aria-live="polite">
      {
        residenceTypes.map((t, i) => (
          <dl class:list={['types__stat-set', i === 0 && 'is-active']} data-type-panel aria-hidden={i !== 0 ? 'true' : undefined}>
            {t.stats.map((s) => (
              <div>
                <dt class="l1 muted">{s.label}</dt>
                <dd class="h5">{s.value}</dd>
              </div>
            ))}
          </dl>
        ))
      }
    </div>

    <div class="types__image" data-cursor="drag" data-types-viewport>
      {
        residenceTypes.map((t, i) => (
          <div class:list={['types__slide', i === 0 && 'is-active']} data-type-slide>
            <Media media={t.image} fill sizes="(max-width: 767px) 80vw, 30vw" />
          </div>
        ))
      }
    </div>

    <div class="types__aside">
      {
        residenceTypes.map((t, i) => (
          <div class:list={['types__aside-set', i === 0 && 'is-active']} data-type-panel aria-hidden={i !== 0 ? 'true' : undefined}>
            <p class="types__summary p1">{t.summary}</p>
            <ul class="types__features l1">
              {t.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="types__titles" aria-live="polite">
      {
        residenceTypes.map((t, i) => (
          <h2 class:list={['types__title h2', i === 0 && 'is-active']} data-type-title data-fit="0.9" aria-hidden={i !== 0 ? 'true' : undefined}>
            {t.name}
          </h2>
        ))
      }
    </div>

    <div class="types__controls slider__controls l2">
      <button class="icon-btn" data-dir="prev" data-types-prev aria-label="Previous residence type" data-cursor="link">
        <svg viewBox="0 0 8 14" fill="none" stroke="currentColor"><path d="M7 1 1 7l6 6"></path></svg>
      </button>
      <span class="slider__index" data-types-current>1</span>
      <span class="slider__bar" aria-hidden="true"><span class="slider__bar-fill types__bar-fill" data-types-bar></span></span>
      <span class="slider__index">{n}</span>
      <button class="icon-btn" data-dir="next" data-types-next aria-label="Next residence type" data-cursor="link">
        <svg viewBox="0 0 8 14" fill="none" stroke="currentColor"><path d="m1 1 6 6-6 6"></path></svg>
      </button>
    </div>
  </div>
</section>

<style is:global>
  /* One screen, composed around the portrait: figure on the left, copy on the right,
     the title laid across the foot of the photo and the pager beneath it. Vertical
     measures are in svh so the whole composition always fits the viewport. */
  .types {
    position: relative;
    z-index: 2;
    border-radius: calc(20 * var(--u)) calc(20 * var(--u)) 0 0;
    margin-top: calc(-24 * var(--u));
  }
  .types__inner {
    position: relative;
    height: 100svh;
    min-height: 620px;
    --photo-top: 7svh;
    --photo-h: 77svh;
  }
  .types__stats,
  .types__aside,
  .types__titles {
    display: grid;
  }
  .types__stats > *,
  .types__aside > *,
  .types__titles > * {
    grid-area: 1 / 1;
  }
  [data-type-panel]:not(.is-active),
  [data-type-title]:not(.is-active) {
    visibility: hidden;
  }

  .types__image {
    position: absolute;
    left: 50%;
    top: var(--photo-top);
    height: var(--photo-h);
    aspect-ratio: 3 / 4;
    max-width: 34vw;
    translate: -50% 0;
    overflow: hidden;
    touch-action: pan-y;
  }
  .types__slide {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  .types__slide.is-active {
    visibility: visible;
  }
  /* the foot of the photo melts into the section colour, so the dark title reads across it */
  .types__image::after {
    content: '';
    position: absolute;
    inset: 78% 0 0;
    background: linear-gradient(to top, var(--c-mist) 0%, color-mix(in srgb, var(--c-mist) 60%, transparent) 45%, transparent);
    z-index: 3;
    pointer-events: none;
  }

  .types__stats {
    position: absolute;
    left: calc(350 * var(--u));
    top: calc(var(--photo-top) + var(--photo-h) * 0.38);
  }
  .types__stat-set {
    display: grid;
    gap: calc(34 * var(--u));
  }
  .types__stat-set dd {
    margin-top: calc(10 * var(--u));
  }

  .types__aside {
    position: absolute;
    left: calc(1116 * var(--u));
    top: calc(var(--photo-top) + var(--photo-h) * 0.3);
    width: calc(330 * var(--u));
  }
  .types__aside-set {
    display: grid;
    justify-items: start;
    gap: calc(26 * var(--u));
  }
  .types__summary {
    font-size: max(calc(15 * var(--u)), 14px);
    line-height: 1.5;
  }
  /* features: a short ruled list */
  .types__features {
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .types__features li {
    padding: calc(11 * var(--u)) 0;
    border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    letter-spacing: 0.14em;
  }
  .types__features li:last-child {
    border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent);
  }

  /* title: its baseline rests on the bottom edge of the photo */
  .types__titles {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100svh - var(--photo-top) - var(--photo-h) - 0.12em);
    justify-items: center;
    text-align: center;
    pointer-events: none;
    z-index: 2;
    font-size: calc(var(--h2) * var(--display-optical));
  }
  .types__title {
    white-space: nowrap;
    line-height: 0.9;
  }
  .types__controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 5svh;
    margin: 0;
  }

  @media (max-width: 767px) {
    .types__inner {
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 72px var(--offset) 72px;
    }
    .types__stats,
    .types__image,
    .types__aside,
    .types__titles,
    .types__controls {
      position: relative;
      inset: auto;
      translate: none;
    }
    .types__image {
      order: 1;
      width: 78%;
      max-width: none;
      height: auto;
      aspect-ratio: 3 / 4;
    }
    .types__titles {
      order: 2;
      margin-top: -0.45em;
      width: 100%;
    }
    .types__title {
      white-space: normal;
      font-size: calc(52 * var(--u));
    }
    .types__controls {
      order: 3;
      margin-top: 20px;
    }
    .types__stats {
      order: 4;
      width: 100%;
      margin-top: 40px;
    }
    .types__stat-set {
      justify-items: center;
      text-align: center;
    }
    .types__aside {
      order: 5;
      width: 100%;
      margin-top: 28px;
    }
  }
</style>
