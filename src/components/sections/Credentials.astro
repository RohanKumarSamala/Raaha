---
import { home } from '@/data/home';

const c = home.credentials;
---

<section class="creds t-light" data-header="ink" aria-label="Project credentials">
  <div class="cflower creds__flower creds__flower--r" aria-hidden="true" data-flower>
    <div class="cflower__sway"><img src="/images/bougainvillea-corner.webp" alt="" data-wind="top" width="1327" height="1185" decoding="async" loading="lazy" /></div>
  </div>
  <div class="cflower creds__flower creds__flower--l" aria-hidden="true" data-flower>
    <div class="cflower__sway"><img src="/images/bougainvillea-bush.webp" alt="" data-wind="bottom" width="2000" height="717" decoding="async" loading="lazy" /></div>
  </div>
  <p class="creds__caption l2" data-reveal="lines">{c.caption[0]}<br />{c.caption[1]}</p>
  <span class="creds__rule" data-reveal="line-y"></span>
  <ul class="creds__list" data-reveal="stagger">
    {
      c.items.map((item, i) => (
        <li class="creds__item" data-reveal-item>
          <h3>
            <button type="button" class="creds__toggle h3" aria-expanded="false" aria-controls={`cred-${i}`} data-cred-toggle data-cursor="link">
              <span>{item.title}</span>
              <span class="creds__plus" aria-hidden="true" />
            </button>
          </h3>
          <div class="creds__panel" id={`cred-${i}`} data-cred-panel hidden>
            <p class="p1">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style is:global>
  .creds {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: calc(200 * var(--u)) var(--offset) calc(220 * var(--u));
    overflow: clip;
  }
  .creds > :not(.cflower) {
    position: relative;
    z-index: 4;
  }
  /* sprays hang in from the top-right corner; the bush rises bottom-left */
  .creds__flower--r {
    right: 0;
    top: 0;
    width: calc(430 * var(--u));
  }
  .creds__flower--r img,
  .creds__flower--r canvas {
    scale: -1 1;
  }
  .creds__flower--r .cflower__sway {
    transform-origin: 100% 0;
  }
  .creds__flower--l {
    left: calc(-170 * var(--u));
    bottom: calc(-8 * var(--u));
    width: calc(640 * var(--u));
  }
  .creds__flower--l .cflower__sway,
  .creds__flower--l img {
    transform-origin: 50% 100%;
  }
  @media (max-width: 767px) {
    .creds__flower--r {
      width: 56vw;
    }
    .creds__flower--l {
      left: -30vw;
      width: 110vw;
    }
  }
  .creds__rule {
    width: 1px;
    height: calc(190 * var(--u));
    margin: calc(40 * var(--u)) 0 calc(60 * var(--u));
    background: currentColor;
    opacity: 0.6;
  }
  .creds__list {
    display: grid;
    justify-items: center;
  }
  .creds__toggle {
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    padding: 0 0.28em;
    line-height: 0.98;
    transition: opacity 0.4s;
  }
  .creds__list:hover .creds__toggle:not(:hover):not([aria-expanded='true']) {
    opacity: 0.45;
  }
  .creds__plus {
    position: relative;
    width: 0.16em;
    height: 0.16em;
    margin: 0.06em 0 0 0.08em;
  }
  .creds__plus::before,
  .creds__plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.6s var(--ease-in-out);
  }
  .creds__plus::after {
    transform: rotate(90deg);
  }
  .creds__toggle[aria-expanded='true'] .creds__plus::after {
    transform: rotate(0);
  }
  .creds__toggle[aria-expanded='true'] .creds__plus::before {
    transform: rotate(180deg);
  }
  .creds__panel {
    overflow: hidden;
  }
  .creds__panel p {
    max-width: calc(440 * var(--u));
    margin: calc(18 * var(--u)) auto calc(34 * var(--u));
  }
  @media (max-width: 767px) {
    .creds {
      padding: 96px var(--offset) 110px;
    }
    .creds__toggle {
      font-size: calc(46 * var(--u));
    }
    .creds__panel p {
      max-width: 30em;
    }
  }
</style>
