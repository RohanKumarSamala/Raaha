---
import { home } from '@/data/home';
import Media from '../ui/Media.astro';
import CircleButton from '../ui/CircleButton.astro';

const c = home.cta;
---

<section class="cta t-deep" data-header="light" data-cta aria-labelledby="cta-title">
  <div class="cta__frame t-image" data-cta-frame>
    <div class="cta__media" data-parallax="6">
      <Media media={c.image} fill sizes="100vw" />
    </div>
    <div class="cta__content">
      <p class="cta__intro l2" data-reveal="lines">{c.intro}</p>
      <h2 class="cta__title h1" id="cta-title" data-reveal="lines" data-fit="0.9">
        {c.lines.map((l) => <span class="cta__line">{l}</span>)}
      </h2>
      <p class="cta__sub c1" data-reveal="fade" data-delay="0.3">{c.sub}</p>
      <div class="cta__button">
        <CircleButton label={c.button.label} href={c.button.href} />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .cta {
    position: relative;
    z-index: 2;
    background-color: #7c3821;
    color: var(--c-ivory);
    isolation: isolate;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: url('/raaha-texture.webp') center / cover no-repeat;
    opacity: 0.98;
    pointer-events: none;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 50%, rgba(124, 56, 33, 0.12) 0%, rgba(45, 17, 8, 0.38) 100%);
    pointer-events: none;
  }
  .cta__frame {
    position: relative;
    height: calc(100svh + 160 * var(--u));
    min-height: calc(900 * var(--u));
    overflow: hidden;
  }
  .cta__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .cta__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: calc(60 * var(--u));
    height: 100%;
  }
  .cta__intro {
    max-width: calc(600 * var(--u));
  }
  .cta__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: calc(260 * var(--u));
  }
  .cta__line {
    display: block;
    white-space: nowrap;
  }
  .cta__sub {
    margin-top: calc(56 * var(--u));
    padding-left: 0.8em;
  }
  .cta__button {
    align-self: flex-start;
    margin: calc(90 * var(--u)) 0 0 calc(690 * var(--u));
  }
  @media (max-width: 767px) {
    .cta__frame {
      height: 100svh;
      min-height: 640px;
    }
    .cta__content {
      padding: 90px var(--offset) 0;
    }
    .cta__title {
      margin-top: 90px;
    }
    .cta__line {
      white-space: normal;
    }
    .cta__sub {
      font-size: 11px;
      letter-spacing: 0.5em;
    }
    .cta__button {
      align-self: center;
      margin: 48px 0 0;
    }
  }
</style>
