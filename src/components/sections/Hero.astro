---
import { home } from '@/data/home';
import Media from '../ui/Media.astro';
import CircleButton from '../ui/CircleButton.astro';

const h = home.hero;
---

<section class="hero t-image" data-header="light" data-hero aria-label="Introduction">
  <div class="hero__media" data-hero-media>
    <div class="hero__layer" data-hero-day>
      <Media media={h.day} fill priority sizes="100vw" />
    </div>
    {
      h.night && (
        <div class="hero__layer hero__layer--night" data-hero-night>
          <Media media={h.night} fill sizes="100vw" />
        </div>
      )
    }
  </div>

  <div class="hero__hotspots" aria-label="Points of interest">
    {
      h.hotspots.map((spot, i) => (
        <div class="hotspot" style={`left:${spot.x}%;top:${spot.y}%`} data-hotspot>
          <button type="button" class="hotspot__pin" aria-describedby={`hotspot-${i}`} data-cursor="link">
            <span class="hotspot__ring" />
            <span class="hotspot__core" />
            <span class="sr-only">{spot.title}</span>
          </button>
          <div class="hotspot__tip t-light" id={`hotspot-${i}`} role="tooltip">
            <p class="l2">{spot.title}</p>
            <p class="p2">{spot.text}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="hero__content" data-hero-content>
    <h1 class="hero__title" data-hero-title>
      {h.titleLines.map((line) => <span class="hero__line h1" data-hero-line data-fit="0.75">{line}</span>)}
      <span class="hero__script a2" data-hero-script>{h.script}</span>
    </h1>

    <div class="hero__row">
      <p class="hero__phrase h5" data-hero-phrase>{h.phrase[0]}</p>
      {
        h.night && (
          <button type="button" class="hero__toggle l2" data-hero-toggle aria-pressed="false" aria-label="Show the residences by night" data-cursor="link">
            <span class="hero__toggle-label is-active">{h.toggle[0]}</span>
            <span class="hero__toggle-track" aria-hidden="true">
              <i />
            </span>
            <span class="hero__toggle-label">{h.toggle[1]}</span>
          </button>
        )
      }
      <p class="hero__phrase h5" data-hero-phrase>{h.phrase[1]}</p>
    </div>
  </div>

  <div class="hero__cta" data-hero-cta>
    <CircleButton label={h.cta.label} href={h.cta.href} />
  </div>
</section>

<style is:global>
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    z-index: 0;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .hero__layer {
    position: absolute;
    inset: 0;
  }
  .hero__layer--night {
    clip-path: inset(0% 0% 0% 100%);
  }
  .hero__content {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__title {
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(58 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-weight: 400;
    white-space: nowrap;
  }
  .hero__line {
    display: block;
  }
  .hero__script {
    position: absolute;
    left: 50%;
    top: calc(210 * var(--u));
    translate: -34% 0;
    rotate: -9deg;
    white-space: nowrap;
    padding: 0 0.2em;
  }
  .hero__row {
    position: absolute;
    left: calc(352 * var(--u));
    right: calc(352 * var(--u));
    top: calc(506 * var(--u));
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .hero__phrase:last-child {
    text-align: right;
  }
  .hero__toggle {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: calc(14 * var(--u));
    padding: 10px 0;
    margin-top: calc(-8 * var(--u));
    translate: 0 calc(-56 * var(--u));
  }
  .hero__toggle-label {
    opacity: 0.5;
    transition: opacity 0.6s var(--ease-out);
  }
  .hero__toggle-label.is-active {
    opacity: 1;
  }
  .hero__toggle-track {
    position: relative;
    width: calc(64 * var(--u));
    min-width: 36px;
    height: 1px;
    background: rgb(255 255 255 / 0.35);
  }
  .hero__toggle-track i {
    position: absolute;
    inset: 0;
    width: 50%;
    background: currentColor;
    transition: translate 0.9s var(--ease-in-out);
  }
  .hero__toggle[aria-pressed='true'] .hero__toggle-track i {
    translate: 100% 0;
  }

  .hero__cta {
    position: absolute;
    left: 50%;
    bottom: calc(40 * var(--u));
    translate: -50% 0;
    display: none;
  }

  /* Hotspots */
  .hero__hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hotspot {
    position: absolute;
    pointer-events: auto;
  }
  .hotspot__pin {
    position: relative;
    display: grid;
    place-items: center;
    width: max(calc(30 * var(--u)), 28px);
    height: max(calc(30 * var(--u)), 28px);
    translate: -50% -50%;
    color: var(--c-white);
  }
  .hotspot__ring {
    position: absolute;
    inset: 0;
    border: 1px solid currentColor;
    border-radius: 50%;
    animation: hotspot-pulse 2.8s var(--ease-out) infinite;
  }
  .hotspot__core {
    width: 34%;
    height: 34%;
    border-radius: 50%;
    border: 1px solid currentColor;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.25);
  }
  .hotspot__tip {
    position: absolute;
    left: calc(24 * var(--u));
    bottom: calc(24 * var(--u));
    width: max(calc(230 * var(--u)), 190px);
    padding: calc(16 * var(--u)) calc(18 * var(--u));
    border-radius: calc(10 * var(--u));
    display: grid;
    gap: 6px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s, transform 0.6s var(--ease-out);
    pointer-events: none;
  }
  .hotspot:hover .hotspot__tip,
  .hotspot:focus-within .hotspot__tip {
    opacity: 1;
    transform: none;
  }
  @keyframes hotspot-pulse {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  @media (max-width: 1199px) and (min-width: 768px) {
    .hero__title { top: calc(110 * var(--u)); }
    .hero__script { top: calc(164 * var(--u)); }
    .hero__row { left: var(--offset); right: var(--offset); top: calc(530 * var(--u)); }
  }

  @media (max-width: 767px) {
    .hero__title {
      top: calc(150 * var(--u));
    }
    .hero__script {
      top: calc(108 * var(--u));
    }
    .hero__row {
      left: var(--offset);
      right: var(--offset);
      top: calc(360 * var(--u));
      grid-template-columns: 1fr 1fr;
      row-gap: 18px;
    }
    .hero__phrase {
      font-size: calc(17.6 * var(--u));
    }
    .hero__toggle {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-self: center;
      translate: 0 0;
    }
    .hero__cta {
      display: block;
    }
    .hotspot {
      display: none;
    }
  }
</style>
