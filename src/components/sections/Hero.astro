---
import { home } from '@/data/home';
import Media from '../ui/Media.astro';

const h = home.hero;
---

<section class="hero t-image" data-header="light" data-hero aria-label="Introduction">
  <div class="hero__media" data-hero-media>
    <div class="hero__layer" data-hero-day>
      <Media media={h.day} fill priority sizes="100vw" />
    </div>

    <div class="hero__hotspots" aria-label="Points of interest">
      {
        h.hotspots.map((spot, i) => (
          <div class="hotspot" style={`left:${spot.x}%;top:${spot.y}%`} data-hotspot>
            <button type="button" class="hotspot__pin" aria-describedby={`hotspot-${i}`} data-cursor="link">
              <span class="hotspot__ring" />
              <span class="hotspot__core" />
              <span class="sr-only">{spot.title}</span>
            </button>
            <div class="hotspot__tip" id={`hotspot-${i}`} role="tooltip">
              <div class="hotspot__stamp">
                <div class="hotspot__frame">
                  <p class="hotspot__title h6">{spot.title}</p>
                  <p class="hotspot__text p1">{spot.text}</p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="hero__grad hero__grad--top" aria-hidden="true"></div>
  <div class="hero__grad hero__grad--bot" aria-hidden="true"></div>

  <div class="hero__content" data-hero-content>
    <h1 class="hero__title" data-hero-title>
      {h.titleLines.map((line) => <span class="hero__line h1" data-hero-line data-fit="0.49">{line}</span>)}
      {h.script && <span class="hero__script a2" data-hero-script>{h.script}</span>}
    </h1>

    <div class="hero__row">
      <p class="hero__phrase" data-hero-phrase>{h.phrase[0]}</p>
      <p class="hero__phrase" data-hero-phrase>{h.phrase[1]}</p>
    </div>
  </div>
</section>

<style is:global>
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    z-index: 0;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__layer {
    position: absolute;
    inset: 0;
  }
  .hero__grad {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 2;
  }
  .hero__grad--top {
    top: 0;
    height: 38%;
    background: linear-gradient(180deg, rgb(16 24 38 / 0.52) 0%, rgb(16 24 38 / 0.16) 55%, transparent 100%);
  }
  .hero__grad--bot {
    bottom: 0;
    height: 40%;
    background: linear-gradient(0deg, rgb(16 24 38 / 0.45) 0%, rgb(16 24 38 / 0.12) 50%, transparent 100%);
  }
  .hero__content {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }
  .hero__title {
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(58 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-weight: 400;
    white-space: nowrap;
  }
  .hero__line {
    display: block;
    font-size: calc(var(--h1) * 0.65);
  }
  .hero__script {
    position: absolute;
    left: 50%;
    top: calc(210 * var(--u));
    translate: -34% 0;
    rotate: -9deg;
    white-space: nowrap;
    padding: 0 0.2em;
  }
  .hero__row {
    position: absolute;
    left: calc(470 * var(--u));
    right: calc(470 * var(--u));
    top: calc(375 * var(--u));
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  /* set in the sub-heading face: spaced capitals, not the display serif */
  .hero__phrase {
    font-family: var(--font-subheading, var(--font-body));
    font-size: max(calc(15 * var(--u)), 11px);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .hero__phrase:last-child {
    text-align: right;
  }

  /* Hotspots */
  .hero__hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* above the title and phrases, so an open card is never written over */
    z-index: 4;
  }
  .hotspot {
    position: absolute;
    pointer-events: auto;
  }
  .hotspot__pin {
    position: relative;
    display: grid;
    place-items: center;
    width: max(calc(30 * var(--u)), 28px);
    height: max(calc(30 * var(--u)), 28px);
    translate: -50% -50%;
    color: var(--c-white);
  }
  .hotspot__ring {
    position: absolute;
    inset: 0;
    border: 1px solid currentColor;
    border-radius: 50%;
    animation: hotspot-pulse 2.8s var(--ease-out) infinite;
  }
  .hotspot__core {
    width: 34%;
    height: 34%;
    border-radius: 50%;
    border: 1px solid currentColor;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.25);
  }
  /* Pop-up card — a postage stamp from the brand deck: perforated cream edge,
     sage keyline, display title up top and the note at the foot. */
  .hotspot__tip {
    position: absolute;
    left: calc(24 * var(--u));
    bottom: calc(24 * var(--u));
    width: max(calc(236 * var(--u)), 210px);
    filter: drop-shadow(0 calc(14 * var(--u)) calc(26 * var(--u)) rgb(30 12 6 / 0.35));
    opacity: 0;
    transform: translateY(10px) rotate(-1.5deg);
    transform-origin: 0 100%;
    transition: opacity 0.4s, transform 0.7s var(--ease-out);
    pointer-events: none;
  }
  .hotspot__stamp {
    --perf: max(calc(14 * var(--u)), 12px); /* perforation pitch */
    padding: calc(var(--perf) * 0.85);
    background: var(--c-ivory);
    color: var(--c-ink-deep);
    -webkit-mask:
      radial-gradient(circle, #0000 calc(var(--perf) * 0.3), #000 calc(var(--perf) * 0.3 + 0.6px))
        calc(var(--perf) / -2) calc(var(--perf) / -2) / var(--perf) var(--perf) round,
      linear-gradient(#000 0 0) center / calc(100% - var(--perf)) calc(100% - var(--perf)) no-repeat;
    mask:
      radial-gradient(circle, #0000 calc(var(--perf) * 0.3), #000 calc(var(--perf) * 0.3 + 0.6px))
        calc(var(--perf) / -2) calc(var(--perf) / -2) / var(--perf) var(--perf) round,
      linear-gradient(#000 0 0) center / calc(100% - var(--perf)) calc(100% - var(--perf)) no-repeat;
  }
  .hotspot__frame {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: calc(40 * var(--u));
    min-height: max(calc(190 * var(--u)), 170px);
    padding: calc(18 * var(--u)) calc(18 * var(--u)) calc(16 * var(--u));
    border: 1px solid var(--c-blush);
    outline: 1px solid color-mix(in srgb, var(--c-blush) 35%, transparent);
    outline-offset: -5px;
  }
  .hotspot__title {
    line-height: 1.02;
  }
  .hotspot__text {
    font-weight: 500;
  }
  .hotspot:hover .hotspot__tip,
  .hotspot:focus-within .hotspot__tip {
    opacity: 1;
    transform: none;
  }
  @keyframes hotspot-pulse {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  @media (max-width: 1199px) and (min-width: 768px) {
    .hero__title { top: calc(90 * var(--u)); }
    .hero__script { top: calc(144 * var(--u)); }
    .hero__row { left: var(--offset); right: var(--offset); top: calc(390 * var(--u)); }
  }

  @media (max-width: 767px) {
    .hero__title {
      top: calc(115 * var(--u));
    }
    .hero__script {
      top: calc(75 * var(--u));
    }
    .hero__row {
      left: var(--offset);
      right: var(--offset);
      top: calc(275 * var(--u));
      display: flex;
      justify-content: space-between;
    }
    .hero__phrase {
      font-size: calc(14 * var(--u));
    }
    .hotspot {
      display: none;
    }
  }
</style>
