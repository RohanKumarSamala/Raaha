---
import { home } from '@/data/home';
import Media from '../ui/Media.astro';

const h = home.hero;
---

<section class="hero t-image" data-header="light" data-hero aria-label="Introduction">
  <div class="hero__media" data-hero-media>
    <div class="hero__layer" data-hero-day>
      <Media media={h.day} fill priority sizes="100vw" />
    </div>

    <div class="hero__hotspots" aria-label="Points of interest">
      {
        h.hotspots.map((spot, i) => (
          <div class="hotspot" style={`left:${spot.x}%;top:${spot.y}%`} data-hotspot>
            <button type="button" class="hotspot__pin" aria-describedby={`hotspot-${i}`} data-cursor="link">
              <span class="hotspot__ring" />
              <span class="hotspot__core" />
              <span class="sr-only">{spot.title}</span>
            </button>
            <div class="hotspot__tip t-light" id={`hotspot-${i}`} role="tooltip">
              <p class="l2">{spot.title}</p>
              <p class="p2">{spot.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="hero__grad hero__grad--top" aria-hidden="true"></div>
  <div class="hero__grad hero__grad--bot" aria-hidden="true"></div>

  <div class="hero__content" data-hero-content>
    <h1 class="hero__title" data-hero-title>
      {h.titleLines.map((line) => <span class="hero__line h1" data-hero-line data-fit="0.49">{line}</span>)}
      {h.script && <span class="hero__script a2" data-hero-script>{h.script}</span>}
    </h1>

    <div class="hero__row">
      <p class="hero__phrase h5" data-hero-phrase>{h.phrase[0]}</p>
      <p class="hero__phrase h5" data-hero-phrase>{h.phrase[1]}</p>
    </div>
  </div>
</section>

<style is:global>
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    z-index: 0;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__layer {
    position: absolute;
    inset: 0;
  }
  .hero__grad {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 2;
  }
  .hero__grad--top {
    top: 0;
    height: 38%;
    background: linear-gradient(180deg, rgb(16 24 38 / 0.52) 0%, rgb(16 24 38 / 0.16) 55%, transparent 100%);
  }
  .hero__grad--bot {
    bottom: 0;
    height: 40%;
    background: linear-gradient(0deg, rgb(16 24 38 / 0.45) 0%, rgb(16 24 38 / 0.12) 50%, transparent 100%);
  }
  .hero__content {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }
  .hero__title {
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(58 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-weight: 400;
    white-space: nowrap;
  }
  .hero__line {
    display: block;
    font-size: calc(var(--h1) * 0.65);
  }
  .hero__script {
    position: absolute;
    left: 50%;
    top: calc(210 * var(--u));
    translate: -34% 0;
    rotate: -9deg;
    white-space: nowrap;
    padding: 0 0.2em;
  }
  .hero__row {
    position: absolute;
    left: calc(300 * var(--u));
    right: calc(300 * var(--u));
    top: calc(375 * var(--u));
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .hero__phrase:last-child {
    text-align: right;
  }

  /* Hotspots */
  .hero__hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }
  .hotspot {
    position: absolute;
    pointer-events: auto;
  }
  .hotspot__pin {
    position: relative;
    display: grid;
    place-items: center;
    width: max(calc(30 * var(--u)), 28px);
    height: max(calc(30 * var(--u)), 28px);
    translate: -50% -50%;
    color: var(--c-white);
  }
  .hotspot__ring {
    position: absolute;
    inset: 0;
    border: 1px solid currentColor;
    border-radius: 50%;
    animation: hotspot-pulse 2.8s var(--ease-out) infinite;
  }
  .hotspot__core {
    width: 34%;
    height: 34%;
    border-radius: 50%;
    border: 1px solid currentColor;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.25);
  }
  .hotspot__tip {
    position: absolute;
    left: calc(24 * var(--u));
    bottom: calc(24 * var(--u));
    width: max(calc(230 * var(--u)), 190px);
    padding: calc(16 * var(--u)) calc(18 * var(--u));
    border-radius: calc(10 * var(--u));
    display: grid;
    gap: 6px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s, transform 0.6s var(--ease-out);
    pointer-events: none;
  }
  .hotspot:hover .hotspot__tip,
  .hotspot:focus-within .hotspot__tip {
    opacity: 1;
    transform: none;
  }
  @keyframes hotspot-pulse {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  @media (max-width: 1199px) and (min-width: 768px) {
    .hero__title { top: calc(90 * var(--u)); }
    .hero__script { top: calc(144 * var(--u)); }
    .hero__row { left: var(--offset); right: var(--offset); top: calc(390 * var(--u)); }
  }

  @media (max-width: 767px) {
    .hero__title {
      top: calc(115 * var(--u));
    }
    .hero__script {
      top: calc(75 * var(--u));
    }
    .hero__row {
      left: var(--offset);
      right: var(--offset);
      top: calc(275 * var(--u));
      display: flex;
      justify-content: space-between;
    }
    .hero__phrase {
      font-size: calc(14 * var(--u));
    }
    .hotspot {
      display: none;
    }
  }
</style>
