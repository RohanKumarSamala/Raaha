---
import { home } from '@/data/home';
import Media from '../ui/Media.astro';

const l = home.location;
---

<section class="location" data-header="ink" data-location aria-label="Location">
  <div class="location__sticky t-image">
    <div class="location__media" data-location-media>
      <Media media={l.image} fill sizes="100vw" />
    </div>

    <div class="location__fog" aria-hidden="true" data-location-fog>
      {Array.from({ length: 7 }, (_, i) => <span class={`location__cloud location__cloud--${i}`} data-cloud />)}
    </div>

    <div class="location__head" data-location-head>
      <h2 class="location__title h2">
        {l.headline.map((line) => <span class="location__title-line">{line}</span>)}
      </h2>
      <p class="location__script a1">{l.script}</p>
      <p class="location__sub c1">{l.sub}</p>
    </div>

    <p class="location__caption" data-location-caption>
      <span class="location__tick" aria-hidden="true"></span>
      <span class="l2">{l.caption[0]}</span>
      <span class="p2">{l.caption[1]}</span>
      <span class="p2">{l.caption[2]}</span>
    </p>
  </div>
</section>

<style is:global>
  .location {
    position: relative;
    height: 220svh;
    background: var(--c-ivory);
    z-index: 1;
  }
  .location__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .location__media {
    position: absolute;
    inset: 0;
  }
  .location__fog {
    position: absolute;
    inset: -10%;
    pointer-events: none;
  }
  .location__cloud {
    position: absolute;
    width: 70%;
    height: 70%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--c-ivory) 30%, rgb(243 242 235 / 0.8) 52%, rgb(243 242 235 / 0.35) 75%, transparent 100%);
    will-change: transform, opacity;
  }
  .location__cloud--0 { left: -10%; top: -10%; }
  .location__cloud--1 { left: 35%; top: -15%; }
  .location__cloud--2 { right: -15%; top: 0; }
  .location__cloud--3 { left: -15%; top: 35%; }
  .location__cloud--4 { left: 20%; top: 30%; width: 80%; }
  .location__cloud--5 { right: -10%; top: 40%; }
  .location__cloud--6 { left: 10%; bottom: -20%; width: 90%; }

  .location__head {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--c-ink);
  }
  .location__title-line {
    display: block;
  }
  .location__script {
    margin-top: calc(-70 * var(--u));
    rotate: -8deg;
    color: var(--c-deep);
  }
  .location__sub {
    margin-top: calc(10 * var(--u));
    padding-left: 0.8em;
  }
  .location__caption {
    position: absolute;
    left: calc(1098 * var(--u));
    bottom: calc(96 * var(--u));
    display: grid;
    gap: calc(4 * var(--u));
    padding-left: calc(20 * var(--u));
    opacity: 0;
  }
  .location__caption .l2 {
    margin-bottom: calc(18 * var(--u));
    max-width: 12em;
  }
  .location__tick {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: currentColor;
  }
  @media (max-width: 767px) {
    .location {
      height: 180svh;
    }
    .location__caption {
      left: var(--offset);
      bottom: 48px;
    }
    .location__script {
      margin-top: -20px;
    }
  }
</style>
