---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResidenceCard from '@/components/residences/ResidenceCard.astro';
import Filters from '@/components/residences/Filters.astro';
import Media from '@/components/ui/Media.astro';
import Cta from '@/components/sections/Cta.astro';
import Contact from '@/components/sections/Contact.astro';
import { residences } from '@/data/residences';
import { home } from '@/data/home';

// Editorial image cards interleaved with the grid (PLACEHOLDER copy).
const promos = [
  { at: 4, title: 'Boutique concept', text: home.concept.statement, media: home.space.images.terrace },
  { at: 9, title: 'Built to stay', text: home.architecture.quote, media: home.cta.image },
];
const items: Array<{ kind: 'card'; r: (typeof residences)[number] } | { kind: 'promo'; p: (typeof promos)[number] }> = [];
residences.forEach((r, i) => {
  const promo = promos.find((p) => p.at === i);
  if (promo) items.push({ kind: 'promo', p: promo });
  items.push({ kind: 'card', r });
});
const available = residences.filter((r) => r.status !== 'sold').length;
---

<BaseLayout
  title="Residences"
  description="Browse every available RAHA residence by typology, bedrooms and area."
  header="ink"
  page="residences"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Select a residence' }]}
>
  <section class="listing t-light" data-header="ink" data-listing>
    <header class="listing__head">
      <h1 class="listing__title h1" data-reveal="chars-blur">Residences</h1>
      <p class="listing__count a1" aria-live="polite">
        <span data-listing-count>{available}</span><span class="sr-only"> residences available</span>
      </p>
    </header>

    <div class="listing__filters" data-reveal="fade" data-delay="0.2">
      <Filters />
    </div>

    <div class="listing__grid" data-listing-grid>
      {
        items.map((it) =>
          it.kind === 'card' ? (
            <ResidenceCard residence={it.r} />
          ) : (
            <article class="promo t-image" data-promo>
              <Media media={it.p.media} fill sizes="(max-width: 767px) 90vw, 28vw" />
              <div class="promo__copy">
                <h2 class="h5">{it.p.title}</h2>
                <p class="p2">{it.p.text}</p>
              </div>
            </article>
          ),
        )
      }
    </div>
    <p class="listing__empty h5" data-listing-empty hidden>No residences match these filters.</p>
  </section>

  <Cta />
  <Contact />
</BaseLayout>

<style is:global>
  .listing {
    padding: calc(290 * var(--u)) calc(66 * var(--u)) calc(200 * var(--u)) calc(198 * var(--u));
    min-height: 100svh;
  }
  .listing__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .listing__title {
    color: var(--c-ink);
    margin-bottom: calc(-10 * var(--u));
  }
  .listing__count {
    line-height: 0.8;
    margin-right: calc(-4 * var(--u));
    font-variant-numeric: lining-nums;
  }
  .listing__filters {
    margin-top: calc(56 * var(--u));
  }
  .listing__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(16 * var(--u));
    margin-top: calc(130 * var(--u));
  }
  .promo {
    position: relative;
    overflow: hidden;
    border-radius: calc(4 * var(--u));
    min-height: calc(560 * var(--u));
  }
  .promo .media__inner {
    transition: transform 1.4s var(--ease-out);
  }
  @media (hover: hover) {
    .promo:hover .media__inner {
      transform: scale(1.05);
    }
  }
  .promo__copy {
    position: absolute;
    left: calc(28 * var(--u));
    right: calc(28 * var(--u));
    bottom: calc(28 * var(--u));
    display: grid;
    gap: calc(10 * var(--u));
  }
  .listing__empty {
    margin-top: calc(80 * var(--u));
    text-align: center;
    opacity: 0.6;
  }
  @media (max-width: 1199px) {
    .listing {
      padding-left: calc(140 * var(--u));
    }
  }
  @media (max-width: 767px) {
    .listing {
      padding: 150px var(--offset) 96px;
    }
    .listing__head {
      align-items: flex-end;
    }
    .listing__title {
      font-size: calc(62 * var(--u));
    }
    .listing__filters {
      margin-top: 24px;
    }
    .listing__grid {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 40px;
    }
    .promo {
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
  }
</style>
