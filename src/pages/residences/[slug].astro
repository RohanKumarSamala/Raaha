---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/ui/Media.astro';
import PillButton from '@/components/ui/PillButton.astro';
import RollText from '@/components/ui/RollText.astro';
import ResidenceCard from '@/components/residences/ResidenceCard.astro';
import Amenities from '@/components/sections/Amenities.astro';
import Cta from '@/components/sections/Cta.astro';
import Contact from '@/components/sections/Contact.astro';
import { residences, typeById, formatArea, type Residence } from '@/data/residences';

export const getStaticPaths = (() =>
  residences.map((r, i) => ({
    params: { slug: r.slug },
    props: {
      residence: r,
      prev: residences[(i - 1 + residences.length) % residences.length],
      next: residences[(i + 1) % residences.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  residence: Residence;
  prev: Residence;
  next: Residence;
}
const { residence: r, prev, next } = Astro.props;
const type = typeById(r.typeId);

const stats = [
  { label: 'Bedrooms', value: String(r.bedrooms) },
  { label: 'Interior area', value: formatArea(r.interior) },
  r.terrace && { label: 'Terrace', value: formatArea(r.terrace) },
  r.garden && { label: 'Garden', value: formatArea(r.garden) },
  r.solarium && { label: 'Solarium', value: formatArea(r.solarium) },
].filter(Boolean) as { label: string; value: string }[];

const similar = residences
  .filter((x) => x.slug !== r.slug)
  .sort((a, b) => Number(b.typeId === r.typeId) - Number(a.typeId === r.typeId) || Math.abs(a.interior - r.interior) - Math.abs(b.interior - r.interior))
  .slice(0, 6);

const context = `Residence ${r.number}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Apartment',
  name: `Residence Nº${r.number}`,
  description: r.info,
  numberOfRooms: r.bedrooms,
  numberOfBedrooms: r.bedrooms,
  numberOfBathroomsTotal: r.bathrooms,
  floorSize: { '@type': 'QuantitativeValue', value: r.interior, unitCode: 'MTK' },
  floorLevel: r.floor,
};
---

<BaseLayout
  title={`Residence Nº${r.number}`}
  description={`${type.name} Nº${r.number} — ${r.bedrooms} bedrooms, ${r.interior} m² interior. ${r.info}`}
  header="ink"
  page="residence"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Residences', href: '/residences' }, { label: r.number }]}
  jsonLd={jsonLd}
>
  <section class="unit t-light" data-header="ink" data-unit>
    <div class="unit__gallery">
      <div class="unit__plan" data-reveal="fade">
        {r.floorplans.map((p) => <Media media={p} ratio="1 / 1" fit="contain" sizes="(max-width: 767px) 100vw, 55vw" priority />)}
        <div class="unit__compass" style={`--rot:${r.orientation}deg`} aria-label={`Orientation ${r.orientation}°`} role="img">
          <svg viewBox="0 0 60 60" fill="none" stroke="currentColor" aria-hidden="true">
            <circle cx="30" cy="30" r="29" stroke-opacity=".3" />
            <g class="unit__needle"><path d="M30 8 35 30H25Z" fill="currentColor" stroke="none" /><path d="M30 52 35 30H25Z" stroke-width="1" /></g>
          </svg>
          <span class="l2">N</span>
        </div>
      </div>
      {
        r.gallery.map((g) => (
          <div class="unit__image" data-reveal="image">
            <Media media={g} ratio="4 / 5" sizes="(max-width: 767px) 100vw, 55vw" />
          </div>
        ))
      }
      <nav class="unit__pager" aria-label="Other residences">
        <a href={`/residences/${prev.slug}`} class="unit__pager-link" data-roll data-cursor="link">
          <span class="l2 muted">Previous</span>
          <span class="h4"><RollText text={`Nº${prev.number}`} /></span>
        </a>
        <a href={`/residences/${next.slug}`} class="unit__pager-link unit__pager-link--next" data-roll data-cursor="link">
          <span class="l2 muted">Next</span>
          <span class="h4"><RollText text={`Nº${next.number}`} /></span>
        </a>
      </nav>
    </div>

    <aside class="unit__panel" data-unit-panel>
      <div class="unit__panel-inner">
        <h1 class="unit__title h3" data-reveal="chars">No. {r.number}</h1>
        <p class="l2 unit__type">{type.name}</p>
        <p class="l2 muted">Completion: {r.completion} · Block {r.block} · Floor {r.floor}</p>
        {r.status !== 'available' && <p class="unit__status l2">{r.status}</p>}

        <dl class="unit__stats" data-reveal="stagger">
          {
            stats.map((s) => (
              <div data-reveal-item>
                <dt class="l1 muted">{s.label}</dt>
                <dd class="h5">{s.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="unit__tabs" data-tabs>
          <div class="unit__tablist l2" role="tablist" aria-label="Residence details">
            <button role="tab" id="tab-info" aria-selected="true" aria-controls="panel-info" data-tab data-cursor="link">Info</button>
            <button role="tab" id="tab-features" aria-selected="false" aria-controls="panel-features" tabindex="-1" data-tab data-cursor="link">Features</button>
            <span class="unit__tab-line" data-tab-line aria-hidden="true"></span>
          </div>
          <div class="unit__tabpanels">
            <div role="tabpanel" id="panel-info" aria-labelledby="tab-info" class="p2" data-tabpanel>
              <p>{r.info}</p>
            </div>
            <div role="tabpanel" id="panel-features" aria-labelledby="tab-features" class="p2" data-tabpanel hidden>
              <ul class="unit__features">{r.features.map((f) => <li>{f}</li>)}</ul>
            </div>
          </div>
        </div>

        <div class="unit__actions">
          <PillButton label="Submit a request" action="booking" context={context} />
          {
            r.pdf ? (
              <a class="btn-circle btn-circle--sm l2" href={r.pdf} download data-cursor="link" data-no-transition aria-label={`Download plan PDF for residence ${r.number}`}>
                PDF
              </a>
            ) : (
              <span class="unit__pdf l2 muted" title="PDF available soon">PDF</span>
            )
          }
        </div>
      </div>
    </aside>

    <div class="unit__mobile-bar t-light">
      <p class="l2">Nº{r.number} · {r.bedrooms} bed / {r.interior} m²</p>
      <PillButton label="Request" action="booking" context={context} />
    </div>
  </section>

  <div class="amen-stack">
    <Amenities id="unit-amenities" />
  </div>

  <section class="similar t-light" data-header="ink" data-similar aria-labelledby="similar-title">
    <div class="similar__head">
      <p class="l2" data-reveal="fade">Similar options</p>
      <h2 class="similar__title h4" id="similar-title" data-reveal="lines">Other residences that might suit your needs</h2>
      <div class="similar__controls">
        <button class="icon-btn" data-dir="prev" data-similar-prev aria-label="Scroll to previous residences" data-cursor="link">
          <svg viewBox="0 0 8 14" fill="none" stroke="currentColor"><path d="M7 1 1 7l6 6"></path></svg>
        </button>
        <button class="icon-btn" data-dir="next" data-similar-next aria-label="Scroll to next residences" data-cursor="link">
          <svg viewBox="0 0 8 14" fill="none" stroke="currentColor"><path d="m1 1 6 6-6 6"></path></svg>
        </button>
      </div>
    </div>
    <div class="similar__rail" data-similar-rail data-lenis-prevent-wheel data-cursor="drag">
      {similar.map((s) => <ResidenceCard residence={s} class="similar__card" />)}
    </div>
    <div class="similar__all">
      <PillButton label="View all" href="/residences" />
    </div>
  </section>

  <Cta />
  <Contact slot="before-footer" />
</BaseLayout>

<style is:global>
  .unit {
    position: relative;
    display: grid;
    grid-template-columns: calc(760 * var(--u)) calc(330 * var(--u));
    column-gap: calc(64 * var(--u));
    padding: calc(48 * var(--u)) 0 calc(160 * var(--u)) calc(222 * var(--u));
    z-index: 2;
  }
  .unit__gallery {
    display: grid;
    gap: calc(16 * var(--u));
  }
  .unit__plan {
    position: relative;
    padding: calc(60 * var(--u)) calc(40 * var(--u));
  }
  .unit__compass {
    position: absolute;
    right: calc(10 * var(--u));
    bottom: calc(10 * var(--u));
    width: max(calc(52 * var(--u)), 40px);
    display: grid;
    place-items: center;
  }
  .unit__compass svg {
    width: 100%;
  }
  .unit__needle {
    transform-origin: 30px 30px;
    transform: rotate(var(--rot));
  }
  .unit__compass .l2 {
    margin-top: 6px;
  }
  .unit__pager {
    display: flex;
    justify-content: space-between;
    margin-top: calc(64 * var(--u));
    padding-top: calc(28 * var(--u));
    border-top: 1px solid var(--ink-10);
  }
  .unit__pager-link {
    display: grid;
    gap: calc(8 * var(--u));
  }
  .unit__pager-link--next {
    text-align: right;
    justify-items: end;
  }

  .unit__panel {
    position: relative;
  }
  .unit__panel-inner {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: calc(36 * var(--u)) 0 calc(40 * var(--u));
    gap: calc(8 * var(--u));
  }
  .unit__title {
    margin-bottom: calc(26 * var(--u));
    white-space: nowrap;
  }
  .unit__type {
    font-weight: 700;
  }
  .unit__status {
    align-self: flex-start;
    margin-top: 10px;
    padding: 5px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
  }
  .unit__stats {
    display: grid;
    gap: calc(24 * var(--u));
    margin-top: calc(60 * var(--u));
  }
  .unit__stats dd {
    margin-top: calc(8 * var(--u));
  }
  .unit__tabs {
    margin-top: calc(44 * var(--u));
    max-width: calc(280 * var(--u));
  }
  .unit__tablist {
    position: relative;
    display: flex;
    gap: calc(24 * var(--u));
    padding-bottom: calc(10 * var(--u));
    border-bottom: 1px solid var(--ink-10);
  }
  .unit__tablist [role='tab'] {
    min-height: 32px;
    opacity: 0.45;
    transition: opacity 0.4s;
  }
  .unit__tablist [role='tab'][aria-selected='true'] {
    opacity: 1;
  }
  .unit__tab-line {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 40px;
    background: currentColor;
    transition: transform 0.7s var(--ease-in-out), width 0.7s var(--ease-in-out);
  }
  .unit__tabpanels {
    padding-top: calc(16 * var(--u));
    min-height: calc(110 * var(--u));
  }
  .unit__features {
    display: grid;
    gap: 4px;
  }
  .unit__features li::before {
    content: '— ';
    opacity: 0.5;
  }
  .unit__actions {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--u));
    margin-top: auto;
    padding-top: calc(40 * var(--u));
  }
  .unit__pdf {
    display: grid;
    place-items: center;
    width: max(calc(40 * var(--u)), 44px);
    height: max(calc(40 * var(--u)), 44px);
    border: 1px solid currentColor;
    border-radius: 50%;
    letter-spacing: 0.1em;
  }
  .unit .btn-circle--sm {
    border: 1px solid currentColor;
    letter-spacing: 0.1em;
  }
  .unit__mobile-bar {
    display: none;
  }

  .similar {
    position: relative;
    z-index: 2;
    padding: calc(180 * var(--u)) 0 calc(180 * var(--u));
  }
  .similar__head {
    position: relative;
    margin: 0 calc(222 * var(--u));
    display: grid;
    gap: calc(20 * var(--u));
  }
  .similar__title {
    max-width: calc(760 * var(--u));
  }
  .similar__controls {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    gap: 8px;
  }
  .similar__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(436 * var(--u));
    gap: calc(16 * var(--u));
    margin-top: calc(64 * var(--u));
    padding: 0 calc(222 * var(--u));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: calc(222 * var(--u));
    scrollbar-width: none;
    cursor: grab;
  }
  .similar__rail::-webkit-scrollbar {
    display: none;
  }
  .similar__card {
    scroll-snap-align: start;
  }
  .similar__all {
    display: flex;
    justify-content: center;
    margin-top: calc(56 * var(--u));
  }

  @media (max-width: 1199px) and (min-width: 768px) {
    .unit {
      grid-template-columns: 1fr calc(300 * var(--u));
      padding-left: calc(120 * var(--u));
      padding-right: var(--offset);
    }
  }
  @media (max-width: 767px) {
    .unit {
      display: flex;
      flex-direction: column-reverse;
      padding: 130px var(--offset) 96px;
    }
    .unit__panel-inner {
      position: static;
      min-height: 0;
      padding: 0 0 32px;
    }
    .unit__title {
      font-size: calc(64 * var(--u));
    }
    .unit__stats {
      grid-template-columns: 1fr 1fr;
      margin-top: 28px;
    }
    .unit__tabs {
      max-width: none;
      margin-top: 32px;
    }
    .unit__actions {
      padding-top: 28px;
    }
    .unit__plan {
      padding: 0;
    }
    .unit__mobile-bar {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: 12px;
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 8px 8px 8px 18px;
      border: 1px solid var(--ink-10);
      border-radius: 999px;
      transform: translateY(160%);
      transition: transform 0.7s var(--ease-out);
    }
    .unit__mobile-bar.is-visible {
      transform: none;
    }
    .similar {
      padding: 96px 0;
    }
    .similar__head {
      margin: 0 var(--offset);
    }
    .similar__controls {
      display: none;
    }
    .similar__title {
      font-size: calc(32 * var(--u));
    }
    .similar__rail {
      grid-auto-columns: 82%;
      gap: 12px;
      padding: 0 var(--offset);
      scroll-padding-inline: var(--offset);
      margin-top: 32px;
    }
  }
</style>
