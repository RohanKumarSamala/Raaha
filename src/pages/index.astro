---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Reasons from '@/components/sections/Reasons.astro';
import Quote from '@/components/sections/Quote.astro';
import Concept from '@/components/sections/Concept.astro';
import ResidenceTypes from '@/components/sections/ResidenceTypes.astro';
import Statement from '@/components/sections/Statement.astro';
import Amenities from '@/components/sections/Amenities.astro';
import Space from '@/components/sections/Space.astro';
import Architecture from '@/components/sections/Architecture.astro';
import Credentials from '@/components/sections/Credentials.astro';
import Cta from '@/components/sections/Cta.astro';
import Contact from '@/components/sections/Contact.astro';
import { home } from '@/data/home';
---

<BaseLayout title={undefined} description={home.seo.description} header="light" page="home">
  <!-- 1–2 · Hero held sticky while the arch rises as an overlay over the photo -->
  <div class="hero-stack" data-hero-stack>
    <Hero />
    <Reasons />
  </div>

  <!-- 4 · Community statement -->
  <Quote text={home.quote.text} author={home.quote.author} image={home.quote.image} blend="var(--c-mist)" />

  <!-- 5–6 · Concept, place, route (horizontal) -->
  <Concept />

  <!-- 8 · Residence types -->
  <ResidenceTypes />

  <!-- 8b · The estate in one line -->
  <Statement />

  <!-- 9–10 · Amenities (sticky) with the lifestyle arch rising over them -->
  <div class="amen-stack">
    <Amenities />
    <Space />
  </div>

  <!-- 11 · Architecture -->
  <Architecture />

  <!-- 12 · Developer & licences -->
  <Credentials />

  <!-- 13–14 · Call to action + booking -->
  <Cta />
  <Contact slot="before-footer" />
</BaseLayout>

<style is:global>
  .hero-stack {
    position: relative;
  }
  .amen-stack {
    position: relative;
  }
</style>
